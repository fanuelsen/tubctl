TUB_HOST=172.31.0.105
TUB_PORT=12416
PORT=3000
# Time display in the webapp: "24" (default) or "12"
TIME_FORMAT=24
# Timezone the recurring scheduler uses (IANA name). Defaults to UTC; set this
# to your local zone or schedule times will fire at the wrong wall-clock hour.
TZ=Europe/Oslo
# Directory where recurring daily schedules are persisted (schedules.json).
# Defaults to ./data; the Docker image uses /data (a named volume).
DATA_DIR=data
# Optional shared secret. If set, POST /api/set and PUT /api/schedules require
# it via 'X-Auth-Token' or 'Authorization: Bearer'. Leave empty on a trusted LAN.
# AUTH_TOKEN=
# Optional comma-separated Host allowlist for write endpoints (anti DNS-rebinding),
# e.g. tub.local,192.168.1.50. Leave empty to accept any Host.
# ALLOWED_HOSTS=
# slog level: debug|info|warn|error
LOG_LEVEL=info
